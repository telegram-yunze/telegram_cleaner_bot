# ============================================================
# .env.example — 配置模板，复制为 .env 后填写实际值
# 注意：.env 文件包含敏感信息，不要提交到版本控制
# ============================================================

# ── 数据库 ────────────────────────────────────────────────────────────────────
# 本地开发使用 SQLite（无需额外安装）
DATABASE_URL=sqlite+aiosqlite:///./telegram_cleaner_bot.db

# 生产环境建议使用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telegram_cleaner_bot

# 是否打印 SQL 语句到日志（调试用，生产应保持 false）
SQLALCHEMY_ECHO=false

# ── 应用运行 ──────────────────────────────────────────────────────────────────
# 是否开启调试模式（生产必须为 false）
DEBUG=false

# uvicorn 监听地址（默认 0.0.0.0 监听所有网卡）
HOST=0.0.0.0

# uvicorn 监听端口
PORT=8000

# API 路由前缀
API_PREFIX=/api

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# 从 @BotFather 获取的 Bot Token（必填）
# 示例：1234567890:ABCDefghIJKlmnOPQRstUVwxyz
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Webhook 公网 HTTPS 地址（使用 Webhook 模式时必填）
# 示例：https://bot.example.com
WEBHOOK_BASE_URL=https://your-domain.com

# Webhook 路径（一般无需修改）
WEBHOOK_PATH=/webhook/telegram

# ── 安全 ──────────────────────────────────────────────────────────────────────
# API 鉴权密钥（必填，建议使用 openssl rand -hex 32 生成）
API_SECRET_KEY=change-me-to-a-random-32-char-string
