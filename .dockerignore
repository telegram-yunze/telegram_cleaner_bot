# ── 版本控制 ──────────────────────────────────────────────────
.git
.gitignore

# ── 虚拟环境（容器内会重新安装依赖）─────────────────────────────
.venv
venv
env

# ── Python 编译缓存 ────────────────────────────────────────────
__pycache__
**/__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
dist
build

# ── 本地数据库文件 ─────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── 日志与运行时文件 ───────────────────────────────────────────
*.log
run.log
run.pid

# ── 环境变量文件（含敏感信息，不能打包进镜像）───────────────────
.env
.env.local
.env.*.local

# ── IDE 配置 ───────────────────────────────────────────────────
.vscode
.idea
*.iml

# ── 测试产物 ───────────────────────────────────────────────────
.pytest_cache
.coverage
htmlcov

# ── 文档与预览文件 ─────────────────────────────────────────────
openapi.preview.json
docs
